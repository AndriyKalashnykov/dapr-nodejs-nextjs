# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Build
FROM docker.io/node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build
ENV NODE_ENV=development
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
WORKDIR /app
COPY package.json .npmrc next.config.ts postcss.config.mjs tsconfig.json eslint.config.mjs ./
# pnpm v11 reads the `allowBuilds` map ONLY from `pnpm-workspace.yaml`
# (the legacy `pnpm.onlyBuiltDependencies` array in package.json and the
# `.npmrc shamefully-hoist` key are silently ignored). This dev image
# builds standalone (compose context = `app/web-nextjs/`) so the root
# repo's workspace yaml isn't reachable — emit a minimal local copy with
# the same `allowBuilds` list as the root yaml so `pnpm install` doesn't
# trip `[ERR_PNPM_IGNORED_BUILDS]` on sharp / protobufjs postinstalls.
# `packages: []` keeps this from being interpreted as a real workspace
# (no `app/*` to find in this single-package context).
RUN printf 'packages: []\nallowBuilds:\n  "@scarf/scarf": true\n  esbuild: true\n  protobufjs: true\n  sharp: true\n' > pnpm-workspace.yaml && \
    pnpm install
WORKDIR /app/public
COPY public ./

# Run
FROM docker.io/node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS runtime
RUN corepack enable && corepack prepare pnpm@11.15.1 --activate
WORKDIR /app
COPY --from=build /app /app
COPY /src /app/src
EXPOSE 3001
# Dev-only image: docker-compose bind-mounts ./src and `next dev` writes
# `.next/` cache into the working directory. With `USER node`, host
# UID/GID mismatch on the bind mount causes EACCES. The DS-0002 trivy
# finding is suppressed for this file in `.trivyignore.yaml` — the prod
# runtime image (`Dockerfile`) does run as `node`.
CMD [ "pnpm", "run", "dev" ]

# pnpm config. Project is on pnpm v11 (`packageManager` field in
# package.json). Hoist + override config lives in `pnpm-workspace.yaml`
# (pnpm v11 ignores both the `pnpm.*` block in `package.json` and the
# legacy `shamefully-hoist` key in `.npmrc` — replaced by
# `publicHoistPattern: ['*']` in `pnpm-workspace.yaml`).
#
# These keys are still honored by pnpm v11 via `.npmrc`:
auto-install-peers=true
strict-peer-dependencies=false
